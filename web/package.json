{
  "name": "aihistory-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIhistory1012 网页工作台：本机打开一本书，左右对照 PDF 与 Markdown",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "workbench": "tsx server/workbench.ts",
    "dev": "tsx server/workbench.ts --dev",
    "prebuild": "node scripts/ensure-plugin-deps.mjs",
    "build": "node scripts/build.mjs",
    "postinstall": "node scripts/copy-pdfjs.mjs && node scripts/ensure-plugin-deps.mjs",
    "typecheck": "node scripts/ensure-plugin-deps.mjs && tsc --noEmit",
    "pretest": "npm run fixture",
    "test": "vitest run",
    "test:e2e": "npm run fixture && npm run build && playwright test",
    "check": "npm run fixture && node scripts/ensure-plugin-deps.mjs && tsc --noEmit && vitest run",
    "fixture": "python -X utf8 scripts/make-fixture.py"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "chokidar": "5.0.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.3",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@codemirror/view": "6.43.14",
    "@codemirror/state": "6.7.6"
  }
}
