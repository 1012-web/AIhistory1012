__pycache__/
*.pyc
.pytest_cache/

# 处理过程中在 MinerU 输出目录里生成的报告，不属于 skill 本身
_probe.txt
_markers.tsv
_build_report.txt
_verify.txt
_diff_report.txt
_skeleton.md

# 绝不提交待处理的文献原文与解析产物（版权）
*.pdf
*.json
images/

# 例外：插件清单、Obsidian 清单、插件源码与测试夹具里的 JSON 要提交
!.claude-plugin/*.json
!/manifest.json
!/versions.json
!obsidian/**/*.json
!web/*.json
!tests/fixtures/**
tests/fixtures/**/*.pdf
# 例外：公版演示书《新史學》的排印本（维基文库，CC BY-SA 4.0），测试用
!tests/fixtures/新史學.pdf
# 上面的 ! 把 fixtures 下的一切又放了回来，Python 缓存要再排除一次
tests/fixtures/**/__pycache__/
tests/fixtures/**/*.pyc

# Obsidian 插件与网页工作台
node_modules/
dist/
*.log
.scratch/
.obsidian-cache/
