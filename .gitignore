__pycache__/
*.pyc

# 绝不提交待处理的文献原文与解析产物（版权）
*.pdf
*.json
images/

# 例外：Obsidian 清单、插件源码与测试夹具里的 JSON 要提交
!/manifest.json
!/versions.json
!obsidian/**/*.json
!web/*.json
!tests/fixtures/**
tests/fixtures/**/*.pdf
# 例外：随仓库分发的 Obsidian 库骨架（这些 .json 是配置，不是文献数据）
!vault-template/.obsidian/*.json
# 例外：公版演示书《新史學》的排印本（维基文库，CC BY-SA 4.0），测试用
!tests/fixtures/新史學.pdf
# 上面的 ! 把 fixtures 下的一切又放了回来，Python 缓存要再排除一次
tests/fixtures/**/__pycache__/
tests/fixtures/**/*.pyc

# Obsidian 插件与网页工作台
node_modules/
dist/
*.log
.scratch/
.obsidian-cache/

# 预览站：主页手写，site/demo/ 是 web/ 静态导出的产物（npm run demo 生成，由 CI 现造）
site/demo/
